{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "dev-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "dev-mock",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3002"],
      "env": { "AGENTS_MOCK": "1" },
      "port": 3002
    }
  ]
}
