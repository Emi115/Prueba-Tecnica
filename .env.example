# Clave de la API de Gemini (https://aistudio.google.com/apikey). Solo se lee en el servidor:
# no le pongas el prefijo NEXT_PUBLIC_. Sin ella, los agentes funcionan en modo simulado.
GEMINI_API_KEY=AIzaSy-ejemplo-sustituye-por-tu-clave

# Modelo que usan los tres agentes (por defecto gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Modelo de Gemini de respaldo si el principal está saturado (misma clave). "none" lo desactiva.
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# IA de respaldo gratuita (https://console.groq.com/keys, sin tarjeta). Solo se lee en el servidor.
# Se usa si Gemini está saturado, no responde o devuelve 429. Sin ella, se omite este respaldo.
GROQ_API_KEY=gsk_ejemplo-sustituye-por-tu-clave
# GROQ_MODEL=openai/gpt-oss-120b

# Postgres de Neon. En Vercel la crea la integración de Neon automáticamente.
# Sin ella, en local se usa PGlite (Postgres en memoria).
DATABASE_URL=postgresql://usuario:contraseña@ep-ejemplo-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Límite global de peticiones nuevas por hora (protege la clave en la URL pública)
# RUNS_PER_HOUR=20

# Forzar modo simulado aunque haya clave
# AGENTS_MOCK=1
